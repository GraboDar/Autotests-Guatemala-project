# ─────────────────────────────────────────────────────────────
# Active environment — picks which {ENV}_* block below is used
# (base URL + credentials), AND is reused as the Qase reporting
# environment tag (QASE_MODE=testops QASE_ENVIRONMENT=stage ...).
# One of: dev, stage, uat, prod. Defaults to "stage" if unset.
# ─────────────────────────────────────────────────────────────
QASE_ENVIRONMENT=stage

# ─────────────────────────────────────────────────────────────
# Base URLs — Admin Panel per environment
# ─────────────────────────────────────────────────────────────
DEV_BASE_URL=
STAGE_BASE_URL=https://stage-admin.sanmartinbakery.com
UAT_BASE_URL=
PROD_BASE_URL=

# ─────────────────────────────────────────────────────────────
# DEV — users
# ─────────────────────────────────────────────────────────────
DEV_SUPERADMIN_EMAIL=
DEV_SUPERADMIN_PASSWORD=
DEV_STOREMANAGER_EMAIL=
DEV_STOREMANAGER_PASSWORD=

# ─────────────────────────────────────────────────────────────
# STAGE — users
# ─────────────────────────────────────────────────────────────
# Super Admin (has full Stock Management access including Configurations)
STAGE_SUPERADMIN_EMAIL=
STAGE_SUPERADMIN_PASSWORD=
# Store Manager (has Stock Management access but NOT Configurations)
STAGE_STOREMANAGER_EMAIL=
STAGE_STOREMANAGER_PASSWORD=
# Read Only — Configurations (view only, no create/edit/delete)
STAGE_SMRO_EMAIL=
STAGE_SMRO_PASSWORD=

# ─────────────────────────────────────────────────────────────
# UAT — users
# ─────────────────────────────────────────────────────────────
UAT_SUPERADMIN_EMAIL=
UAT_SUPERADMIN_PASSWORD=
UAT_STOREMANAGER_EMAIL=
UAT_STOREMANAGER_PASSWORD=

# ─────────────────────────────────────────────────────────────
# PROD — users
# ─────────────────────────────────────────────────────────────
PROD_SUPERADMIN_EMAIL=
PROD_SUPERADMIN_PASSWORD=
PROD_STOREMANAGER_EMAIL=
PROD_STOREMANAGER_PASSWORD=

# ─────────────────────────────────────────────────────────────
# Shared across environments (not env-specific)
# ─────────────────────────────────────────────────────────────
# Test data - entity that exists in STAGE Ingredient class list
INGREDIENT_CLASS_ENTITY=Sahar-class

QASE_TESTOPS_API_TOKEN=your-qase-api-token

# NOTE: Bulk Import API spec (e2e/api/ingredients-bulk-import.spec.ts) is
# hardcoded to the STAGE API URL and reads this key as a flat var, not
# per-environment. Left as-is intentionally — not restructured yet.
BULK_IMPORT_API_KEY=your-api-key
